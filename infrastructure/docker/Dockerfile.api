FROM node:20-alpine AS base

RUN npm install -g pnpm

WORKDIR /app

# Copy package files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/api/package.json ./apps/api/
COPY packages/database/package.json ./packages/database/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/ai-prompts/package.json ./packages/ai-prompts/

# Install dependencies
RUN pnpm install --frozen-lockfile || pnpm install

# Copy source files
COPY . .

# Generate Prisma client
RUN pnpm --filter @voicedesk/database db:generate

# Build packages
RUN pnpm --filter @voicedesk/shared-types build
RUN pnpm --filter @voicedesk/ai-prompts build

EXPOSE 3001

CMD ["pnpm", "--filter", "@voicedesk/api", "dev"]
