# ===========================================
# VoiceDesk AI - MVP Environment Variables
# Copy this to .env and fill in your values
# ===========================================

# Database (local Docker - no changes needed)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voicedesk?schema=public"
REDIS_URL="redis://localhost:6379"

# Twilio (REQUIRED - get from https://console.twilio.com)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."

# Deepgram (REQUIRED - get from https://console.deepgram.com)
DEEPGRAM_API_KEY="..."

# ElevenLabs (REQUIRED - get from https://elevenlabs.io)
ELEVENLABS_API_KEY="..."
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"  # Rachel - professional female

# OpenAI (REQUIRED - get from https://platform.openai.com)
OPENAI_API_KEY="sk-..."

# App Settings
NODE_ENV="development"
API_PORT=3001
API_HOST="0.0.0.0"
LOG_LEVEL="debug"

# ngrok URL (REQUIRED - run ngrok first, then paste here)
# This gets set automatically by the startup script
API_URL="https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app"

# JWT (for API auth - can use default for testing)
JWT_SECRET="mvp-testing-secret-change-in-production-32chars"

# Dashboard (not needed for MVP phone test)
DASHBOARD_URL="http://localhost:3000"

# Disable features not needed for MVP
ENABLE_RECORDING="false"
